import express from 'express';
const app = express();

import { filmes, clientes } from './banco-fake.js';

// Habilita JSON
app.use(express.json());

// Controle de ID automático
let idAtual = clientes.length > 0 ? clientes[clientes.length - 1].id + 1 : 1;

// ================= FILMES =================

app.get('/filmes', (request, response) => {
    return response.json(filmes);
});

app.get('/filmes/:genero', (request, response) => {
    const genero_comp = request.params.genero;

    const filmes_filtrados = filmes.filter(f => f.genero === genero_comp);
    return response.json(filmes_filtrados);
});

// ================= CLIENTES =================

//  Atividade 03 + 04 (POST com validação de duplicidade)
app.post('/clientes', (request, response) => {
    const { nome, email } = request.body;

    // Validação básica
    if (!nome || !email) {
        return response.status(400).json({
            erro: 'Nome e email são obrigatórios'
        });
    }

    //  Atividade 04: Verificar duplicidade de email
    const emailExiste = clientes.find(c => c.email === email);

    if (emailExiste) {
        return response.status(400).json({
            erro: 'Este email já está cadastrado'
        });
    }

    // Criando novo cliente
    const novoCliente = {
        id: idAtual++,
        nome,
        email
    };

    clientes.push(novoCliente);

    return response.status(201).json(novoCliente);
});

//  Atividade 05: Buscar cliente por ID
app.get('/clientes/:id', (request, response) => {
    const id = parseInt(request.params.id);

    const cliente = clientes.find(c => c.id === id);

    if (!cliente) {
        return response.status(404).json({
            erro: 'Cliente não encontrado'
        });
    }

    return response.json(cliente);
});

// Servidor
app.listen(3333, () => console.log("Servidor rodando na porta 3333"));
